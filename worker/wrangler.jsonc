{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rss-de-valor-private-feeds",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "PRIVATE_FEEDS_BUCKET",
      "bucket_name": "rss-de-valor-private-feeds"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
